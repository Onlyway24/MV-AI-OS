{
  "name": "mv-ai-os",
  "version": "0.1.0",
  "private": true,
  "description": "A modular AI operating system for coordinated agents, memory, tools, and workflows.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mv-ai-os": "./dist/cli/local-runtime-cli.js"
  },
  "files": [
    "dist",
    "docs/ARCHITECTURE.md",
    "docs/CORE_V1_OPERATOR_GUIDE.md",
    "docs/MV_AI_OS_CONSTITUTION.md",
    "docs/project-state/01_CURRENT_STATE.md",
    "examples/core-v1"
  ],
  "engines": {
    "node": "22.23.x"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "build": "node ./scripts/clean-dist.mjs && tsc --project tsconfig.build.json",
    "cli": "node ./dist/cli/local-runtime-cli.js",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --dir tests --passWithNoTests",
    "typecheck": "tsc --project tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.0",
    "eslint": "10.6.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vitest": "4.1.9"
  }
}
